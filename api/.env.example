PORT=4000
JWT_SECRET=replace-me-with-a-long-random-string
WEB_ORIGIN=http://localhost:3000

# Medusa (Express completes the Medusa cart after Wire payment succeeds)
MEDUSA_URL=http://localhost:9000
MEDUSA_PK=pk_your_publishable_key

# Botxon payment gateway (https://botxon.chat) — QPay + Mongolian bank apps.
# Money settles into the merchant's own QPay account. This is the ACTIVE gateway.
# Leave BOTXON_GATEWAY_KEY empty for MOCK mode (invoice auto-"pays" after 5s, dev only).
# In production the api REFUSES to boot without BOTXON_GATEWAY_KEY.
# Get the key + webhook secret from Botxon's /owner/gateway page.
# Register the webhook URL as:  https://<your-storefront-domain>/api/webhooks/botxon
BOTXON_GATEWAY_URL=https://botxon.chat
BOTXON_GATEWAY_KEY=
BOTXON_WEBHOOK_SECRET=

# Wire Payment (https://wire.mn) — legacy alternate gateway, no longer used by
# checkout (kept for reference). Leave blank.
WIRE_SECRET_KEY=
WIRE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend transactional email (order confirmation). Empty = mock (logs only).
# Get a key at resend.com. Verify a domain for EMAIL_FROM in production.
RESEND_API_KEY=
EMAIL_FROM=Naran Amerik Baraa <onboarding@resend.dev>

# Error monitoring (optional; blank = disabled)
SENTRY_DSN=
