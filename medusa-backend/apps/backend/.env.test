# Integration test env (loaded by jest.config.js `loadEnv("test", ...)`).
# No real secrets. @medusajs/test-utils builds its test-DB URL from these DB_*
# vars (NOT DATABASE_URL) and creates/drops a throwaway database (DB_TEMP_NAME).
# Must be "localhost" (not 127.0.0.1): test-utils enables SSL for any non-
# localhost host, which a plain local Postgres rejects → connection timeout.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=naran
DB_PASSWORD=naran
DB_TEMP_NAME=naran_integration_test
JWT_SECRET=test-jwt-secret
COOKIE_SECRET=test-cookie-secret
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000
# Explicitly blank so they override any value from a loaded .env — the meili
# plugin is gated on MEILISEARCH_HOST, and Redis on NODE_ENV=production; blank
# keeps tests free of external search/cache deps.
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=
REDIS_URL=
