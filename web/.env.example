API_URL=http://localhost:4000

# Set to 1 to route search through MeiliSearch (requires backend MEILISEARCH_HOST)
NEXT_PUBLIC_MEILISEARCH=0

# Public site origin (sitemap.xml / robots.txt / canonical). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://naranamerikbaraa.mn

# Analytics (optional; loaded only after cookie consent). Leave blank to disable.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Error monitoring (optional; blank = disabled)
NEXT_PUBLIC_SENTRY_DSN=
